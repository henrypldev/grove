{
  "name": "grove",
  "version": "0.15.0-beta.5",
  "private": true,
  "workspaces": [
    "docs"
  ],
  "type": "module",
  "bin": {
    "grove": "./dist/index.js"
  },
  "scripts": {
    "server": "NODE_ENV=production bun run src/server/index.ts",
    "dev": "bun build:simserver && NODE_ENV=development bun run --watch src/server/index.ts",
    "cli": "bun src/cli/index.tsx",
    "docs": "bun run --cwd docs dev",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun test src/server/",
    "compile": "bun build --compile --minify src/cli/index.tsx --outfile=grove",
    "build:simserver": "cd simulator-server && swift build -c release && cd .."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.68",
    "drizzle-orm": "^0.45.1",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.9",
    "drizzle-kit": "^0.31.9",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.21.0"
  }
}
