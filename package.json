{
	"name": "grove",
	"private": false,
	"version": "0.14.0",
	"workspaces": [
		"packages/*",
		"shared"
	],
	"scripts": {
		"server": "bun run --cwd packages/server start",
		"dev": "NODE_ENV=development bun run --cwd packages/server dev",
		"cli": "bun run --cwd packages/cli dev",
		"docs": "bun run --cwd packages/docs dev",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"release": "bun scripts/release.ts",
		"test": "bun test packages/server/src/",
		"build:sdk": "bun run --cwd packages/sdk build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@types/bun": "latest"
	}
}
